# 墨坊 InkStudio — Ubuntu Server 部署
# 复制为 .env（start.sh 会自动创建；也可手动改 DEPLOY_HOST）

# 改成这台 Ubuntu 服务器的公网 IP（start.sh 首次也会尝试自动探测）
DEPLOY_HOST=改成你的公网IP

# CORS_ORIGIN 未设置时 start.sh 会按 DEPLOY_HOST 自动追加
# CORS_ORIGIN=http://你的IP:8080,http://你的IP:5000,capacitor://localhost,https://localhost,http://localhost

JWT_SECRET=

# mongo-express 可视化（http://IP:8081）
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=
