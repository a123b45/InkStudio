# 复制为 .env 后按需修改
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/slate-mern-app

JWT_SECRET=请换成生产环境随机长密钥

# 备案前 IP 部署（前端默认 nginx :8080，API :5000）
DEPLOY_HOST=193.112.202.161
# CORS_ORIGIN 未设置时，会自动允许 http://{DEPLOY_HOST} 及 :8080/:5000
# 也可手动指定：
# CORS_ORIGIN=http://193.112.202.161:8080,http://193.112.202.161:5000,capacitor://localhost,https://localhost

# 备案后域名示例：
# DEPLOY_HOST=
# CORS_ORIGIN=https://inkstudio.work,https://www.inkstudio.work,capacitor://localhost,https://localhost
